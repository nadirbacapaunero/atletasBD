# MONGODB - Atlas connection string
# Get from: https://cloud.mongodb.com/v2/your_project/connect
MONGODB_URI=mongodb+srv://username:password@cluster-xxx.mongodb.net/coaching_db?retryWrites=true&w=majority

# STRAVA - OAuth credentials
# Get from: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/callback

# TELEGRAM - Bot token
# Get from: @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

# CLAUDE AI - API key
# Get from: https://console.anthropic.com/
CLAUDE_API_KEY=

# OBSIDIAN - Local vault path
# Example: /Users/username/Documents/Coaching_Vault
OBSIDIAN_VAULT_PATH=/path/to/vault

# ENCRYPTION - Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# SCHEDULER - Timezone for daily sync (Buenos Aires)
# Formats: America/Argentina/Buenos_Aires, UTC, etc.
TIMEZONE=America/Argentina/Buenos_Aires
SYNC_TIME=21:00
